# config.env — biến dùng chung cho mọi script trong repo này.
# Source ở đầu mỗi script:  source "$(dirname "$0")/../config.env"
# Chỉ chứa cấu hình; không chạy lệnh nặng ở đây.

# --- Các repo đã có sẵn trên máy (repo này chỉ gọi sang, không sửa) ---
UNITREE_LEROBOT_DIR="${UNITREE_LEROBOT_DIR:-/home/jkl/Projects/Humanoid/unitree_lerobot}"
XR_TELEOP_DIR="${XR_TELEOP_DIR:-/home/jkl/Projects/Humanoid/xr_teleoperate}"

# Thư mục data thô (JSON teleop) và thư mục convert (lerobot)
RAW_DATA_DIR="${RAW_DATA_DIR:-$XR_TELEOP_DIR/teleop/utils/data}"
CONVERT_SCRIPT="$UNITREE_LEROBOT_DIR/unitree_lerobot/utils/convert_unitree_json_to_lerobot.py"
LEROBOT_DIR="$UNITREE_LEROBOT_DIR/unitree_lerobot/lerobot"
TRAIN_SCRIPT="$LEROBOT_DIR/src/lerobot/scripts/lerobot_train.py"
EVAL_SCRIPT="$UNITREE_LEROBOT_DIR/unitree_lerobot/eval_robot/eval_g1.py"

# --- Môi trường Python (đã cài sẵn lerobot 0.4.1, torch 2.3.0) ---
CONDA_ENV="${CONDA_ENV:-tv}"
# BẮT BUỘC: chặn user site-packages (~/.local) lọt vào, nếu không torchvision ở đó
# sẽ lệch version với torch trong env tv (lỗi torch.library.register_fake).
# Đây là bẫy đã ghi trong xr_teleoperate/Useme.md.
export PYTHONNOUSERSITE=1

# --- Dataset ---
# 5 bộ raw dùng được (cùng task "pick place bottle", cùng setup). Xem docs/dataset.md.
# place_bottle_test1 ĐÃ được convert sẵn nhưng vẫn liệt kê để gộp lại từ raw cho nhất quán.
DATASETS=(
  "pick_bottle_0914_2"
  "place_bottle_0911_2"
  "place_bottle_test1"
  "pick_bottle_0914_1"
  "place_bottle_0911"
)

# Episode cần LOẠI (take hỏng), định dạng "dataset/episode_XXXX". Xem check_dataset.py.
# place_bottle_0911_2/episode_0015: chỉ 26 frame, tay phải không động -> take cắt giữa chừng.
EXCLUDE_EPISODES=(
  "place_bottle_0911_2/episode_0015"
)

# Thư mục staging (symlink 5 bộ trên) để convert gộp một lần
STAGING_DIR="${STAGING_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/staging}"

# repo_id local cho dataset hợp nhất; nằm ở ~/.cache/huggingface/lerobot/<REPO_ID>
REPO_ID="${REPO_ID:-local/pick_place_bottle}"

# robot_type khi convert. G1_INSPIRE_3CAM_CONFIG trong constants.py đã đúng: 3 camera,
# map color_0->cam_left_high (head), color_1->cam_left_wrist, color_2->cam_right_wrist
# (khớp với dataset local/place_bottle_test1 đã convert trước đó).
ROBOT_TYPE="${ROBOT_TYPE:-Unitree_G1_Inspire_3Cam}"

# --- Train ACT (mặc định vừa card 16GB) ---
# Smoke test đo được ~0.20s/step ở batch 8 (data loading không phải nút thắt, VRAM dư nhiều).
# Khuyến nghị: batch 16, 50k step (~2-3 giờ). Tăng batch nếu muốn nhanh/hội tụ tốt hơn.
OUTPUT_DIR="${OUTPUT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/outputs/act_pick_bottle}"
JOB_NAME="${JOB_NAME:-act_pick_bottle}"
ACT_BATCH_SIZE="${ACT_BATCH_SIZE:-16}"
ACT_STEPS="${ACT_STEPS:-50000}"
ACT_SAVE_FREQ="${ACT_SAVE_FREQ:-10000}"

# --- Eval trên robot thật ---
ARM="${ARM:-G1_29}"
EE="${EE:-inspire1}"   # loại end-effector; chỉnh nếu dùng biến thể FTP khác
EVAL_FREQ="${EVAL_FREQ:-30}"

# --- Push checkpoint lên Hugging Face Hub (private) ---
# Điền repo đích của bạn, ví dụ: JKLover0909/act_pick_bottle_g1
HF_REPO="${HF_REPO:-}"
